<Window x:Class="Kaiken.LinkedRoomTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etiquetar Rooms de Vínculo" Height="320" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" Foreground="#1E293B"
                   Margin="0,0,0,16" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Vínculo:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="LinkCombo" Grid.Column="1" Height="26" SelectionChanged="LinkCombo_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tipo de etiqueta:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="TypeCombo" Grid.Column="1" Height="26" IsEditable="True" IsTextSearchEnabled="True"/>
        </Grid>

        <CheckBox x:Name="CropCheck" Grid.Row="3" Margin="0,0,0,12"
                  Content="Solo las que caen dentro de la región de recorte"
                  Checked="CropCheck_Changed" Unchecked="CropCheck_Changed"/>

        <TextBlock x:Name="PreviewText" Grid.Row="4" TextWrapping="Wrap" FontSize="11"
                   Foreground="#1565C0" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" TextWrapping="Wrap" FontSize="10" Foreground="Gray" VerticalAlignment="Top"
                   Text="Etiqueta las habitaciones del vínculo que están en el nivel de la vista (misma cota) y aún no tienen etiqueta en ella. Cada etiqueta va en el punto de referencia de su habitación, sin directriz. Un Ctrl+Z deshace todo."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="6" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="28" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="Etiquetar" Width="120" Height="28" IsDefault="True" FontWeight="Bold" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
