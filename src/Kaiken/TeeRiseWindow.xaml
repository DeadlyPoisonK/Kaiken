<Window x:Class="Kaiken.TeeRiseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rou-T — confirmar altura" Height="365" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" Foreground="#1565C0"
                   Margin="0,0,0,12" FontSize="11"/>

        <StackPanel x:Name="SimplePanel">
            <TextBlock Text="Altura del tramo nuevo (cm)" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="RiseBox" Margin="0,0,0,10"
                     ToolTip="Sugerido: lo que come la Te + lo que come el codo final + 1 cm de margen. Puedes subirlo si el cielo lo permite."/>
        </StackPanel>

        <StackPanel x:Name="ReductionPanel" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Width="170" Margin="0,0,12,0">
                <TextBlock Text="Tramo grande (cm)" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="BigStubBox"
                         ToolTip="Entre la Te y la Transición. Sugerido: mínimo medido + 1 cm."/>
            </StackPanel>
            <StackPanel Width="170">
                <TextBlock Text="Tramo chico (cm)" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="SmallStubBox"
                         ToolTip="Entre la Transición y el codo final. Sugerido: mínimo medido + 1 cm."/>
            </StackPanel>
        </StackPanel>

        <CheckBox x:Name="DownCheck" Margin="0,0,0,10"
                  Content="Conectar hacia abajo (por defecto: hacia arriba)"
                  ToolTip="Sin marcar: el ramal nuevo apunta hacia arriba (+Z), como siempre. Marcado: apunta hacia abajo (-Z)."/>

        <TextBlock Text="El troncal no se toca. La tubería vieja del ramal se sube y reconecta sola, generando el codo. Todo en una sola transacción (Ctrl+Z deshace todo)."
                   TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Rou-T" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
