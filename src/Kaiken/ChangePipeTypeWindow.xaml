<Window x:Class="Kaiken.ChangePipeTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar Familia de Tubería" Height="330" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Cambia el Tipo de Tubería (familia) de la vista actual, sin tocar el diámetro."
                   TextWrapping="Wrap" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,16" Grid.Row="0"/>

        <!-- 1. Familia de origen -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Familia de origen:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="SourceCombo" Grid.Column="1" Height="26" SelectionChanged="SourceCombo_SelectionChanged"/>
        </Grid>

        <!-- 2. Diámetro a filtrar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Diámetro a filtrar:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="DiameterCombo" Grid.Column="1" Height="26" SelectionChanged="DiameterCombo_SelectionChanged"/>
        </Grid>

        <!-- 3. Familia destino -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Familia destino:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="TargetCombo" Grid.Column="1" Height="26" IsEditable="True" IsTextSearchEnabled="True"/>
        </Grid>

        <TextBlock x:Name="PreviewText" Grid.Row="4" TextWrapping="Wrap" FontSize="11"
                   Foreground="#1565C0" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" TextWrapping="Wrap" FontSize="10" Foreground="Gray" VerticalAlignment="Top"
                   Text="Solo cambia la Familia (Tipo) de las tuberías que hoy tienen la familia de origen y el diámetro elegidos. El diámetro y demás parámetros de instancia se conservan tal cual."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="6" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="28" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Cambiar Familia" Width="140" Height="28" IsDefault="True" FontWeight="Bold" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
