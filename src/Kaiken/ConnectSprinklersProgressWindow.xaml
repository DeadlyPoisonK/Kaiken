<Window x:Class="Kaiken.ConnectSprinklersProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectando rociadores…" Height="190" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="StatusText" Text="Preparando…" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ProgressBar x:Name="Bar" Height="18" Minimum="0" Margin="0,0,0,8"/>
        <TextBlock x:Name="CountsText" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Button x:Name="CancelButton" Content="Detener" Width="90" Height="26" HorizontalAlignment="Right" Click="Cancel_Click"
                ToolTip="Detiene después del rociador en curso. Lo ya conectado se conserva."/>
    </StackPanel>
</Window>
