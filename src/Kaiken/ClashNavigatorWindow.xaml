<Window x:Class="Kaiken.ClashNavigatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interferencias" Height="560" Width="760" MinHeight="320" MinWidth="560"
        WindowStartupLocation="Manual" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,4"/>
        <TextBlock x:Name="WarningText" Grid.Row="1" TextWrapping="Wrap" FontSize="11" Foreground="#B45309" Margin="0,0,0,6" Visibility="Collapsed"/>

        <ListView x:Name="List" Grid.Row="2" SelectionMode="Single" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{Binding Brush}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Number}"/>
                    <GridViewColumn Header="Estado" Width="90" DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="Elemento" Width="220" DisplayMemberBinding="{Binding A}"/>
                    <GridViewColumn Header="Choca con" Width="220" DisplayMemberBinding="{Binding B}"/>
                    <GridViewColumn Header="Modelo" Width="140" DisplayMemberBinding="{Binding Source}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="◀ Anterior" Width="90" Height="28" Margin="0,0,6,0" Click="Prev_Click"/>
            <Button Content="Siguiente ▶" Width="90" Height="28" Margin="0,0,12,0" FontWeight="Bold" Click="Next_Click"/>
            <Button x:Name="ResolveButton" Content="Marcar resuelta" Width="120" Height="28" Margin="0,0,6,0" Click="Resolve_Click"/>
            <Button Content="Re-verificar todo" Width="120" Height="28" Margin="0,0,6,0" Click="Recheck_Click"
                    ToolTip="Vuelve a calcular cada choque: los que ya no chocan pasan a «Ya no choca» y salen del rojo; los que siguen se actualizan si el elemento se movió."/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
            <CheckBox x:Name="SectionBoxCheck" Content="Caja de sección al ir a un choque" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="HideDoneCheck" Content="Ocultar resueltas" IsChecked="True" VerticalAlignment="Center" Click="HideDone_Click"/>
            <Button DockPanel.Dock="Right" Content="Cerrar" Width="80" Height="26" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="Ver todo" Width="80" Height="26" Margin="0,0,6,0" Click="ShowAll_Click"
                    ToolTip="Quita la caja de sección y encuadra todos los choques pendientes."/>
        </DockPanel>
    </Grid>
</Window>
