<Window x:Class="Kaiken.ChangeDateAndRevWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar Fecha y REV en Parámetros" Height="320" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Fecha de Revisión (INFO_Fecha):" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="DateTextBox" Text="01-07-2026" Margin="0,0,0,12" FontSize="14" Padding="4"/>

        <TextBlock Text="Aplicar a:" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox x:Name="SetComboBox" Margin="0,0,0,12"
                  ToolTip="Elige un Sheet Set (Publish Set) para modificar solo esas láminas, sin tocar la fecha/revisión de las demás."/>

        <CheckBox x:Name="SyncRevCheckBox" Content="Sincronizar 'INFO_10_Revision' desde el Número de Plano"
                  IsChecked="True" Margin="0,0,0,8"
                  ToolTip="Extrae el 10º segmento (índice 9) del Sheet Number y lo asigna al parámetro INFO_10_Revision."/>

        <CheckBox x:Name="FilterLength29CheckBox" Content="Procesar solo láminas con Número de Plano &gt; 29 caracteres"
                  IsChecked="True" Margin="0,0,0,16"
                  ToolTip="Misma regla del script de Dynamo para omitir portadas u otras láminas secundarias."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Aplicar" Width="90" IsDefault="True" Click="Apply_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
