<Window x:Class="Kaiken.AlignViewportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alinear Viewports" Height="560" Width="900" MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Foreground="#1E293B" Margin="0,0,0,10">
            <Run FontWeight="Bold" Text="Cada lámina marcada toma el scope box guardado para su sector y su viewport queda en la misma posición del papel que en el archivo."/>
            <LineBreak/>
            <Run Foreground="Gray" FontSize="11" Text="Además: viewport &quot;Sin título&quot;, recorte activo pero oculto y annotation crop marcado. En azul, las láminas de las que se guardó la alineación. Las de otra escala vienen desmarcadas; si falta el scope box en este modelo, no se pueden marcar."/>
        </TextBlock>

        <DataGrid x:Name="RowsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                  HorizontalGridLinesBrush="#E2E8F0" RowHeaderWidth="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsReference}" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanToggle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Sector" Binding="{Binding Sector}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="Lámina" Binding="{Binding SheetLabel}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Vista" Binding="{Binding ViewName}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Escala" Binding="{Binding Scale}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Scope box" Binding="{Binding ScopeBox}" IsReadOnly="True" Width="1.5*"/>
                <DataGridTextColumn Header="Nota" Binding="{Binding Note}" IsReadOnly="True" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Marcar seleccionadas" Height="26" Padding="10,0" Margin="0,0,8,0" Click="CheckSelected_Click"/>
            <Button Content="Desmarcar seleccionadas" Height="26" Padding="10,0" Margin="0,0,16,0" Click="UncheckSelected_Click"/>
            <CheckBox x:Name="HideBoxesCheck" Content="Ocultar scope boxes y section boxes" IsChecked="True" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#1565C0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Alinear" Width="120" Height="28" IsDefault="True" FontWeight="Bold" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
